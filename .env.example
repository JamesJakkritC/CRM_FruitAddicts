# ---------------------------------------------------------------------------
# Fruit Addicts CRM - environment example. Copy to .env and fill real values.
# NEVER commit a real .env. No real LINE credentials live in this repo.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SQLite database file (WAL + busy_timeout are enabled in code, not here).
# For Postgres later, swap DB_DRIVER and add DATABASE_URL (see README).
DB_DRIVER=sqlite
DB_FILE=./data/crm.db
DB_BUSY_TIMEOUT_MS=5000

# Staff auth is user-based with RBAC (login -> session token). These bootstrap a
# single super_admin on first `npm run seed`. CHANGE THE PASSWORD before any real
# use, then create real users and disable/rotate this account.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=changeme-admin-8chars

# LIFF / member API auth.
# In production, set LINE_VERIFY_ID_TOKEN=true and configure LINE_CHANNEL_ID
# so member requests are authenticated by verifying the LINE ID token.
# In dev, LINE_VERIFY_ID_TOKEN=false trusts the X-Line-User-Id header (dev only).
LINE_VERIFY_ID_TOKEN=false
LIFF_ID=0000000000-xxxxxxxx

# LINE provider adapter. LINE_PROVIDER=mock writes messages to the outbox table
# and logs them (no network, no credentials needed - default for dev/test).
# Set LINE_PROVIDER=line ONLY with real credentials in a real deployment.
LINE_PROVIDER=mock
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Loyalty configuration (REQUIRED - no hardcoded engine default).
# PROVISIONAL values pending owner sign-off (loyalty.rules_approved stays false
# until confirmed via PATCH /api/admin/settings/loyalty). See ASSUMPTIONS.md.
POINT_EARN_BAHT_PER_POINT=50
POINT_REDEEM_BAHT_PER_POINT=1
POINT_EXPIRY_DAYS=365

# Background worker (npm run worker) intervals, milliseconds.
# Outbox dispatch runs often; point expiry + PDPA retention run daily.
WORKER_OUTBOX_INTERVAL_MS=60000
WORKER_EXPIRY_INTERVAL_MS=86400000

# PDPA: at-rest PII encryption (AES-256-GCM) for free-form custom fields
# (members.extra_json). OPTIONAL: if unset, encrypt()/decrypt() are transparent
# no-ops and data is stored as plaintext. To enable, set a base64 of 32 random
# bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE: encrypted columns are not searchable. Losing this key makes encrypted
# data unrecoverable, so store it in your secret manager and back it up.
PII_ENCRYPTION_KEY=
